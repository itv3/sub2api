{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-supervisor-campaign-activity-v1.json",
  "title": "Codex 升级 Campaign 父监督器活动",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "classification", "operation", "encoded_operation", "job_id", "started_at_utc", "started_at_epoch", "started_monotonic_ns", "deadline_at_utc", "deadline_at_epoch", "deadline_monotonic_ns", "requested_by_pid"],
  "properties": {
    "schema_version": {"const": "codex-upgrade-campaign-activity/v1"},
    "revision": {"type": "integer", "minimum": 1},
    "classification": {"enum": ["active", "planning", "orchestrator-idle", "waiting"]},
    "operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "encoded_operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "job_id": {"oneOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, {"type": "null"}]},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "started_at_epoch": {"type": "number", "exclusiveMinimum": 0},
    "started_monotonic_ns": {"type": "integer", "minimum": 0},
    "deadline_at_utc": {"type": "string", "format": "date-time"},
    "deadline_at_epoch": {"type": "number", "exclusiveMinimum": 0},
    "deadline_monotonic_ns": {"type": "integer", "minimum": 0},
    "requested_by_pid": {"type": "integer", "minimum": 1},
    "action_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "worker_pid": {"type": "integer", "minimum": 1},
    "worker_started_at_epoch": {"type": "number", "exclusiveMinimum": 0},
    "worker_started_monotonic_ns": {"type": "integer", "minimum": 0},
    "worker_heartbeat_at_epoch": {"type": "number", "exclusiveMinimum": 0},
    "worker_heartbeat_monotonic_ns": {"type": "integer", "minimum": 0},
    "command_pid": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "action_status": {"enum": ["running", "passed", "failed"]},
    "accepted_returncodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "returncode": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
    "reason": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
    "ended_at_epoch": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
    "ended_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
  }
}
