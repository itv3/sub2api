{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-predecessor-control-replacement-import-v10.json",
  "title": "Codex Candidate 零执行控制替代导入收据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at_utc",
    "reason",
    "successor_campaign_id",
    "successor_campaign_manifest_sha256",
    "predecessor_campaign",
    "stages",
    "copied_files",
    "configuration_transition",
    "job_rehearsal_transition",
    "recovery_control_transition",
    "abandoned_candidate_attempt",
    "control_replacement",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "codex-upgrade-predecessor-import/v10"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "reason": {"const": "candidate_recovery_control_replacement"},
    "successor_campaign_id": {"$ref": "#/$defs/safeId"},
    "successor_campaign_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "predecessor_campaign": {"$ref": "#/$defs/campaign"},
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture-official", "classify"],
      "properties": {
        "capture-official": {"type": "object"},
        "classify": {"type": "object"}
      }
    },
    "copied_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "configuration_transition": {"type": "object"},
    "job_rehearsal_transition": {"$ref": "#/$defs/controlTransition"},
    "recovery_control_transition": {"type": "object"},
    "abandoned_candidate_attempt": {"$ref": "#/$defs/sourceAttempt"},
    "control_replacement": {"$ref": "#/$defs/controlReplacement"},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "receiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "receipt_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_dir", "campaign_id", "campaign_manifest_sha256"],
      "properties": {
        "campaign_dir": {"$ref": "#/$defs/absolutePath"},
        "campaign_id": {"$ref": "#/$defs/safeId"},
        "campaign_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "attempt_id",
        "path",
        "sha256",
        "attempt_digest",
        "identity_sha256",
        "status"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/safeId"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "attempt_digest": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "failed"}
      }
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeId"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "attempt_id",
        "attempt_digest",
        "candidate_identity_sha256",
        "source_transition",
        "recovery_scope_sha256",
        "planned_job_ids",
        "execute_job_ids",
        "reused_job_ids",
        "failed_job_ids",
        "pending_job_ids",
        "production_paths",
        "target_scenario"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/safeId"},
        "attempt_id": {"$ref": "#/$defs/safeId"},
        "attempt_digest": {"$ref": "#/$defs/sha256"},
        "candidate_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_transition": {"type": "object"},
        "recovery_scope_sha256": {"$ref": "#/$defs/sha256"},
        "planned_job_ids": {"$ref": "#/$defs/idArray"},
        "execute_job_ids": {"$ref": "#/$defs/idArray"},
        "reused_job_ids": {"$ref": "#/$defs/idArray"},
        "failed_job_ids": {"$ref": "#/$defs/idArray"},
        "pending_job_ids": {"$ref": "#/$defs/idArray"},
        "production_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "target_scenario": {"type": "object"}
      }
    },
    "zeroBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservation_count",
        "attempt_count",
        "checkpoint_count",
        "live_request_count",
        "scanned_bytes"
      ],
      "properties": {
        "reservation_count": {"const": 0},
        "attempt_count": {"const": 0},
        "checkpoint_count": {"const": 0},
        "live_request_count": {"const": 0},
        "scanned_bytes": {"const": 0}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upgrade_timing", "arm64_environment", "job_rehearsal"],
      "properties": {
        "upgrade_timing": {"type": "object"},
        "arm64_environment": {"type": "object"},
        "job_rehearsal": {"type": "object"}
      }
    },
    "controlTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "predecessor", "successor"],
      "properties": {
        "reason": {"const": "current_execution_contract_rehearsal"},
        "predecessor": {"type": "object"},
        "successor": {"type": "object"}
      }
    },
    "stoppedLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_dir",
        "receipt",
        "upgrade_id",
        "evidence_decision",
        "active_phase",
        "head_sequence",
        "head_sha256",
        "total_elapsed_seconds",
        "total_live_request_count",
        "total_deadline_at_utc"
      ],
      "properties": {
        "ledger_dir": {"$ref": "#/$defs/absolutePath"},
        "receipt": {"$ref": "#/$defs/fileBinding"},
        "upgrade_id": {"$ref": "#/$defs/safeId"},
        "evidence_decision": {"enum": ["reuse", "recapture"]},
        "active_phase": {"const": "VC-4"},
        "head_sequence": {"type": "integer", "minimum": 1},
        "head_sha256": {"$ref": "#/$defs/sha256"},
        "total_elapsed_seconds": {"type": "integer", "minimum": 0},
        "total_live_request_count": {"const": 0},
        "total_deadline_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "supervisorAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_dir",
        "state",
        "stop_receipt",
        "events",
        "minute_ledger",
        "summary"
      ],
      "properties": {
        "run_dir": {"$ref": "#/$defs/absolutePath"},
        "state": {"$ref": "#/$defs/fileBinding"},
        "stop_receipt": {"$ref": "#/$defs/fileBinding"},
        "events": {"$ref": "#/$defs/fileBinding"},
        "minute_ledger": {"$ref": "#/$defs/fileBinding"},
        "summary": {
          "type": "object",
          "required": ["audit_incomplete", "integrity_errors", "state"],
          "properties": {
            "audit_incomplete": {"const": false},
            "integrity_errors": {"type": "array", "maxItems": 0},
            "state": {"enum": ["stopped", "failed"]}
          }
        }
      }
    },
    "controlReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "effective_epoch",
        "runtime_repair",
        "source_campaign",
        "source_attempt",
        "source",
        "effective_controls",
        "unpublished_stop_checkpoint",
        "supervisor_audit",
        "execution_summary"
      ],
      "properties": {
        "boundary": {"$ref": "#/$defs/zeroBoundary"},
        "effective_epoch": {"$ref": "#/$defs/receiptBinding"},
        "runtime_repair": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/receiptBinding"}
          ]
        },
        "source_campaign": {"$ref": "#/$defs/campaign"},
        "source_attempt": {"$ref": "#/$defs/sourceAttempt"},
        "source": {"$ref": "#/$defs/source"},
        "effective_controls": {"$ref": "#/$defs/controls"},
        "unpublished_stop_checkpoint": {"$ref": "#/$defs/stoppedLedger"},
        "supervisor_audit": {"$ref": "#/$defs/supervisorAudit"},
        "execution_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executed_job_ids", "scanned_bytes", "live_request_count"],
          "properties": {
            "executed_job_ids": {"type": "array", "maxItems": 0},
            "scanned_bytes": {"const": 0},
            "live_request_count": {"const": 0}
          }
        }
      }
    }
  }
}
