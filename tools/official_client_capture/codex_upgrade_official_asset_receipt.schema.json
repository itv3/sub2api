{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-official-asset-receipt-v1.json",
  "title": "Codex 官方发布制品 DNS／TLS 预连接收据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "observed_at_utc",
    "asset",
    "network",
    "facts",
    "producer"
  ],
  "properties": {
    "schema_version": {
      "const": "codex-upgrade-official-asset-receipt/v1"
    },
    "status": {
      "const": "passed"
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_metadata",
        "tag_name",
        "published_at",
        "name",
        "size",
        "sha256",
        "browser_download_url"
      ],
      "properties": {
        "release_metadata": {
          "$ref": "#/$defs/fileBinding"
        },
        "tag_name": {
          "type": "string",
          "pattern": "^rust-v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "browser_download_url": {
          "type": "string",
          "pattern": "^https://github\\.com/openai/codex/releases/download/"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_host",
        "port",
        "resolved_ipv4",
        "selected_ipv4",
        "tls_version",
        "certificate_sha256",
        "curl_resolve"
      ],
      "properties": {
        "asset_host": {
          "const": "release-assets.githubusercontent.com"
        },
        "port": {
          "const": 443
        },
        "resolved_ipv4": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        },
        "selected_ipv4": {
          "type": "string",
          "format": "ipv4"
        },
        "tls_version": {
          "type": "string",
          "minLength": 1
        },
        "certificate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "curl_resolve": {
          "type": "string",
          "pattern": "^release-assets\\.githubusercontent\\.com:443:[0-9.]+$"
        }
      }
    },
    "facts": {
      "$ref": "#/$defs/relativeFileBinding"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tool", "tool_sha256", "version"],
      "properties": {
        "schema_version": {
          "const": "codex-upgrade-official-asset-producer/v1"
        },
        "tool": {
          "type": "string",
          "pattern": "^/"
        },
        "tool_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "const": "1"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "relativeFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[^/].*"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
