{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-campaign-lease-stop-v1.json",
  "title": "Codex Campaign 租约停线收据",
  "description": "租约过期、owner 消失或 watchdog 写入失败时只追加的不可覆盖停线事实。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase",
    "candidate_id",
    "owner_pid",
    "owner_nonce",
    "attempt_id",
    "started_at_utc",
    "deadline_at_utc",
    "last_heartbeat_at_utc",
    "operation",
    "reason",
    "detected_at_utc",
    "next_action",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "codex-upgrade-campaign-lease-stop/v1"},
    "campaign_id": {"$ref": "#/$defs/safeId"},
    "phase": {"enum": ["official", "candidate"]},
    "candidate_id": {
      "oneOf": [{"$ref": "#/$defs/safeId"}, {"type": "null"}]
    },
    "owner_pid": {"type": "integer", "minimum": 1},
    "owner_nonce": {"$ref": "#/$defs/sha256"},
    "attempt_id": {
      "oneOf": [{"$ref": "#/$defs/safeId"}, {"type": "null"}]
    },
    "started_at_utc": {"$ref": "#/$defs/rfc3339"},
    "deadline_at_utc": {"$ref": "#/$defs/rfc3339"},
    "last_heartbeat_at_utc": {"$ref": "#/$defs/rfc3339"},
    "operation": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "detected_at_utc": {"$ref": "#/$defs/rfc3339"},
    "next_action": {"type": "string", "minLength": 1},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    }
  }
}
