{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2apiplus.local/schemas/codex-upgrade-campaign-lease-v1.json",
  "title": "Codex Campaign 持久租约",
  "description": "跨 CLI invocation 保存 owner、deadline 和 heartbeat 的可变小型租约；停线收据另行只追加。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "phase",
    "candidate_id",
    "owner_pid",
    "owner_nonce",
    "attempt_id",
    "started_at_utc",
    "deadline_at_utc",
    "last_heartbeat_at_utc",
    "heartbeat_seconds",
    "operation",
    "state",
    "recovered_owner_nonce"
  ],
  "properties": {
    "schema_version": {"const": "codex-upgrade-campaign-lease/v1"},
    "campaign_id": {"$ref": "#/$defs/safeId"},
    "phase": {"enum": ["official", "candidate"]},
    "candidate_id": {
      "oneOf": [{"$ref": "#/$defs/safeId"}, {"type": "null"}]
    },
    "owner_pid": {"type": "integer", "minimum": 1},
    "owner_nonce": {"$ref": "#/$defs/sha256"},
    "attempt_id": {
      "oneOf": [{"$ref": "#/$defs/safeId"}, {"type": "null"}]
    },
    "started_at_utc": {"$ref": "#/$defs/rfc3339"},
    "deadline_at_utc": {"$ref": "#/$defs/rfc3339"},
    "last_heartbeat_at_utc": {"$ref": "#/$defs/rfc3339"},
    "heartbeat_seconds": {"type": "number", "exclusiveMinimum": 0},
    "operation": {"type": "string", "minLength": 1, "maxLength": 256},
    "state": {"enum": ["active", "released", "stop_the_line"]},
    "recovered_owner_nonce": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "official"}}},
      "then": {"properties": {"candidate_id": {"const": null}}}
    },
    {
      "if": {"properties": {"phase": {"const": "candidate"}}},
      "then": {"required": ["candidate_id"]}
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    }
  }
}
